# Django core
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret-key
ALLOWED_HOSTS=sblrent-c9ehdmewcqcfhkh7.eastasia-01.azurewebsites.net,your-custom-domain.com

# Database
USE_POSTGRES=True
DATABASE_URL=postgres://username:password@host:5432/dbname

# Azure Blob storage (media)
AZURE_ACCOUNT_NAME=your-storage-account-name
AZURE_ACCOUNT_KEY=your-storage-account-key
AZURE_CONTAINER=media

# Payments
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Email (SMTP)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Optional app security controls used in production block
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCKOUT_SECONDS=900
